@@ -821,6 +843,22 @@ AppleCLCD::flushPanel(void)
 	uint64_t flushStart = fDbg ? mach_absolute_time() : 0;
 	fDbgFlush++;
 	IOLockLock(fPanelLock);
+	if (fPanelBpp == 4) {
+		/* fbshadow: the cached BGRA backbuffer to the BGRA scanout buffer, one linear copy when the
+		 * strides match (the 750p MDP path), else row by row. */
+		if (fRowBytes == fPanelRowBytes) {
+			memcpy((void *)fPanel, (const void *)fPixels, (size_t)fRowBytes * fHeight);
+		} else {
+			uint32_t n = fRowBytes < fPanelRowBytes ? fRowBytes : fPanelRowBytes;
