+	/*
+	 * fbshadow=1: the 32-bpp MDP-scaled panel (fbw/fbh) scans out this same framebuffer. CoreAnimation's
+	 * software renderer blends into the surface it is given, so hand it a cached backbuffer instead of the
+	 * write-combined scanout memory (whose reads stall a blend) and copy the finished frame once per present.
+	 * This is the 24-bpp path's arrangement, without the packing: the scanout buffer is already BGRA.
+	 */
+	int shadow = 0;
+	if (fPanelBpp == 4 && fPhys != 0 && fRowBytes >= fWidth * 4 &&
+	    PE_parse_boot_argn("fbshadow", &shadow, sizeof(shadow)) && shadow != 0) {
+		IOMemoryDescriptor *pm = IOMemoryDescriptor::withPhysicalAddress(fPhys,
+		    round_page((uint64_t)fRowBytes * fHeight), kIODirectionInOut);
+		fPanelMap = pm != NULL ? pm->map(kIOMapWriteCombineCache) : NULL;
+		OSSafeReleaseNULL(pm);
+		if (fPanelMap != NULL) {
+			fPanel = (uintptr_t)fPanelMap->getVirtualAddress();
+			fPanelRowBytes = fRowBytes;
+			IOLog("SWEET FB: fbshadow=1: cached %ux%u backbuffer, %u-byte scanout rows\n",
+			    fWidth, fHeight, fPanelRowBytes);
+		} else {
+			IOLog("SWEET FB: fbshadow=1: no scanout mapping, direct surface\n");
+		}
+	}
